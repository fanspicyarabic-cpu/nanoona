# ==========================================
# Vercel Environment Variables - إعدادات ومتغيرات البيئة
# ==========================================
# قم بإضافة هذه المتغيرات في إعدادات مشروع Vercel تحت:
# Settings -> Environment Variables

# 1. مفاتيح بوابة SpaceRemit (Live أو Test)
# المفتاح السري (Secret Key) - يستخدم حصراً في خوادم السيرفر الخلفي api/
SPACEREMIT_API_KEY=your_spaceremit_secret_key_here

# المفتاح العام (Public Key) - يستخدم لإنشاء روابط الدفع المعتمدة
SPACEREMIT_PUBLIC_KEY=your_spaceremit_public_key_here

# رمز توقيع الـ Webhook (اختياري لتعزيز التحقق من صحة الإشعارات الواردة من البوابة)
SPACEREMIT_WEBHOOK_SECRET=your_webhook_secret_here

# 2. إعدادات بوت وتليجرام (Telegram Bot Automation)
# توكن البوت الرسمي من @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# معرّف القناة الرسمية أو المغلقة (مثال: @nnano14 أو -1001234567890)
TELEGRAM_CHANNEL_ID=@nnano14

# 3. كلمة سر لوحة التحكم الإدارية (Admin Panel Password)
# كلمة السر الافتراضية إذا لم يتم تحديدها: nanoona2026
ADMIN_PASSWORD=nanoona2026
